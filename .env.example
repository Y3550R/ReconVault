# Application
NODE_ENV=development
HOST=reconvault.sec
PORT=3000
APP_URL=http://reconvault.sec

# Session
SESSION_SECRET=32-length-thingy-over-here
SESSION_NAME=reconvault.sid
SESSION_MAX_AGE=86400000
SESSION_SECURE=false

# Database (MariaDB on port 3315)
DB_HOST=localhost
DB_PORT=3315
DB_ROOT_PASS=SuperSecurePassword9000
DB_WEB_USER=reconvault
DB_WEB_PASS=VerySecurePassword8000
DB_NAME=reconvault
DB_CONNECTION_LIMIT=10
DB_DEFAULT_ADMIN_USER=admin
DB_DEFAULT_ADMIN_PASS=TempPasswordToChangeLater

# Security
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# nmap
NMAP_PATH=/usr/bin/nmap

# Scanning
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT_MS=1800000

# Logging
LOG_LEVEL=info
