# Application
NODE_ENV=development
HOST=reconvault.sec
PORT=3000
APP_URL=http://reconvault.sec:3000

# TLS (set TLS_ENABLED=true to serve HTTPS; key/cert must be readable by the app)
TLS_ENABLED=false
TLS_KEY_PATH=/etc/ssl/reconvault/server.key
TLS_CERT_PATH=/etc/ssl/reconvault/server.crt

# Session
SESSION_SECRET=32-length-thingy-over-here
SESSION_NAME=reconvault.sid
SESSION_MAX_AGE=86400000
SESSION_SECURE=false

# Database (MariaDB on port 3315)
DB_HOST=localhost
DB_PORT=3315
DB_NAME=reconvault
DB_CONNECTION_LIMIT=10

# MariaDB root — only used by runServer_test.sh to provision the database
DB_ROOT_PASS=SuperSecurePassword9000

# Database roles
# The app runtime uses ONLY the readonly and readwrite credentials.
DB_READONLY_USER=reconvault_ro
DB_READONLY_PASS=ReadOnlyPassword7000
DB_READWRITE_USER=reconvault_rw
DB_READWRITE_PASS=ReadWritePassword8000

# Admin DB role — provisioning/schema only, never loaded by the app.
DB_ADMIN_USER=reconvault_admin
DB_ADMIN_PASS=AdminPassword9000

# Initial webapp administrator login (seeded into users/administrators)
DB_DEFAULT_ADMIN_USER=admin
DB_DEFAULT_ADMIN_PASS=TempPasswordToChangeLater

# Security
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# nmap
NMAP_PATH=/usr/bin/nmap

# Scanning
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT_MS=1800000

# Logging
LOG_LEVEL=info
